soong_namespace {
}

android_app_import {
	name: "MiuiExtraPhoto",
	owner: "MiuiExtraPhoto",
	apk: "proprietary/system/priv-app/MiuiExtraPhoto/MiuiExtraPhoto.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
}

android_app_import {
	name: "MiuiGallery",
	owner: "MiuiGallery",
	apk: "proprietary/system/priv-app/MiuiGallery/MiuiGallery.apk",
	overrides: ["Gallery", "Glimpse", "Gallery1"],
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
}

android_app_import {
	name: "MiuiMediaViewer",
	owner: "MiuiMediaViewer",
	apk: "proprietary/system/priv-app/MiuiMediaViewer/MiuiMediaViewer.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
}

prebuilt_etc {
    name: "privapp-com.miui.gallery.xml",
    src: "proprietary/system/etc/permissions/privapp-com.miui.gallery.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}

prebuilt_etc {
    name: "config-com.miui.gallery.xml",
    src: "proprietary/system/etc/sysconfig/config-com.miui.gallery.xml",
    sub_dir: "sysconfig",
    filename_from_src: true,
}

prebuilt_etc {
    name: "default-com.miui.gallery.xml",
    src: "proprietary/system/etc/default-permissions/default-com.miui.gallery.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
}

prebuilt_etc {
    name: "micloud-sdk.xml",
    src: "proprietary/system/etc/permissions/micloud-sdk.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}


android_app_import {
    name: "MIMediaEditorGlobal",
    owner: "xiaomi",
    apk: "proprietary/system/priv-app/MIMediaEditorGlobal/MIMediaEditorGlobal.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
}
